# .gitignore for Terraform projects

# State
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI overrides
.terraformrc
terraform.rc

# CLI config directory
.datarc

# Plan files
*.tfplan
*.plan

# Variable files with sensitive data
*.auto.tfvars
*.auto.tfvars.json
secrets.tfvars

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
